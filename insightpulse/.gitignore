# Environment & secrets — never commit credentials in any form
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.pfx
kubeconfig*
coverage.xml

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Data (keep schemas and generators, ignore actual data files)
data/synthetic/*.csv
data/synthetic/*.parquet
data/niq/
data/benchmarks/*.csv
*.db

# Embedding caches & indexes
data/synthetic/*.npz
*.index
*.index.ids.npy

# Docker
storage/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Terraform — state and plans can embed sensitive values
terraform/.terraform/
terraform/*.tfstate*
terraform/tfplan
terraform/*.tfplan
terraform/crash.log
terraform/override.tf
terraform/*_override.tf
# .terraform.lock.hcl is intentionally committed (provider pinning)

# Experiment outputs (regenerate with make experiments)
experiments/results/
