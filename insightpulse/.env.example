# =============================================================================
# InsightPulse — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Environment Profile ---
# Options: demo | production | test
ENV=demo

# --- LLM API Keys (add the ones you want to use) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Default LLM Model ---
# Used for digital twin generation when no specific model is requested.
# Examples: claude-sonnet-4-6, gpt-4o, ollama/llama3.1
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# --- Database (production only) ---
DB_PASSWORD=change-me-in-production
DATABASE_URL=sqlite+aiosqlite:///app/storage/insightpulse.db

# --- Redis (production only) ---
REDIS_URL=redis://redis:6379/0

# --- Ollama (optional, for local LLM) ---
# Uncomment if running Ollama locally for open-source models
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Application Settings ---
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000

# --- Experiment Settings ---
# Number of synthetic respondents per survey run
DEFAULT_COHORT_SIZE=100
# Number of repeat runs for stability measurement
STABILITY_RUNS=5
