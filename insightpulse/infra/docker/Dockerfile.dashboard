# =============================================================================
# InsightPulse — Streamlit Dashboard Dockerfile
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch first: the default PyPI wheel drags in the multi-GB CUDA
# stack, which the dashboard never uses.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# pyproject.toml AND sources — hatchling cannot build the wheel from
# pyproject.toml alone (packages = ["src/insightpulse"], and the declared
# readme must exist for metadata).
COPY pyproject.toml README.md ./
COPY src/ /app/src/
RUN pip install --no-cache-dir .

COPY dashboard/ /app/dashboard/
COPY .streamlit/ /app/.streamlit/
COPY data/ /app/data/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
